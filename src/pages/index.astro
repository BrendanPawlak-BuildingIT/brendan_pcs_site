---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SITE, SOCIALS } from '../data/site';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 3);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="wrap hero">
    <p class="kicker" data-reveal>{SITE.handle}</p>
    <h1 data-reveal>Tech notes from <em>BrendanPcs</em></h1>
    <p data-reveal>{SITE.description}</p>
    <div class="hero-actions" data-reveal>
      <a class="btn btn-primary" href="/blog">Read the blog</a>
      <a class="btn btn-ghost" href="/about">About me</a>
    </div>
  </section>

  <section class="wrap page-body" aria-labelledby="latest">
    <div class="section-head">
      <h2 id="latest">Latest posts</h2>
      <a class="link-more" href="/blog">All posts →</a>
    </div>

    <div class="post-list">
      {latest.map((post) => <PostCard {post} />)}
    </div>
    {latest.length === 0 && <p>First post is on the way.</p>}
  </section>

  <section class="wrap page-body" aria-labelledby="elsewhere">
    <div class="section-head">
      <h2 id="elsewhere">Elsewhere</h2>
      <span class="link-more">Same handle everywhere — {SITE.handle}</span>
    </div>

    <ul class="socials" data-reveal>
      {
        SOCIALS.map((social) => (
          <li>
            <a class="social-link" href={social.href} rel="me noopener" target="_blank">
              <SocialIcon name={social.icon} />
              {social.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="social-link" href="/rss.xml">
          <SocialIcon name="rss" />
          RSS
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
